{
  "name": "siapai",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test packages apps && cd tools/spike-elysia && bun test",
    "test:scoring": "bun test packages/scoring",
    "typecheck": "tsc --noEmit",
    "validate:docs": "python3 tools/validate_docs.py",
    "demo": "bun packages/scoring/demo.ts",
    "verify": "bun run typecheck && bun run validate:docs && bun run trace && bun test packages apps",
    "test:api": "bun test apps/api",
    "dev": "bun tools/dev-server.ts",
    "check:visual": "bun tools/visual-check.ts",
    "verify:full": "bun run verify && bun run check:visual",
    "trace": "python3 tools/traceability.py",
    "demo:lokal": "bun apps/web/demo/lokal.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "createdb siapai_dev 2>/dev/null; DATABASE_URL=postgres://localhost:5432/siapai_dev drizzle-kit migrate",
    "test:pg": "TEST_DATABASE_URL=postgres://localhost:5432/siapai_test bun test apps/api",
    "verify:pg": "bun run verify && bun run test:pg"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4"
  }
}
